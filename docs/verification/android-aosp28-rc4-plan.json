    ],
    "timeout": 180
  },
  {
    "name": "large-screens",
    "args": [
      "pull",
      "/sdcard/Android/data/studio.ax.arrival/files",
      "/workspace/arrival-runtime-rc4/aosp/large-screens"
    ],
    "timeout": 180
