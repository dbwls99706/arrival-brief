    "args": [
      "shell",
      "am",
      "instrument",
      "-w",
      "-r",
      "-e",
      "class",
      "studio.ax.arrival.VisitFlowInstrumentedTest#savedMemoQrRoundTripsAndClearsWhenEditedOrDriving,studio.ax.arrival.VisitFlowInstrumentedTest#memoQrDoesNotRestoreAfterRecreationAndDeletionClearsIt,studio.ax.arrival.VisitFlowInstrumentedTest#activeMemoAndQrExpireAtTheStoredDeadline,studio.ax.arrival.VisitFlowInstrumentedTest#memoQrEnlargementPreservesPayloadAndClearsOnClose",
      "studio.ax.arrival.test/androidx.test.runner.AndroidJUnitRunner"
    ],
    "timeout": 600,
    "expected_tests": 4
  },
  {
    "name": "large-logcat",
