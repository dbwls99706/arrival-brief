  {
    "name": "070-restore-font",
    "args": [
      "shell",
      "settings",
      "put",
      "system",
      "font_scale",
      "1.0"
    ],
    "timeout": 180
  },
  {
    "name": "071-debug-remove",
    "args": [
      "uninstall",
      "studio.ax.arrival"
    ],
    "timeout": 180
