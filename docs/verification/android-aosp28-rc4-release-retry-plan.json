[
  [
    "wait",
    [
      "wait-for-device"
    ],
    300
  ],
  [
    "hide-os-dialogs",
    [
      "shell",
      "until settings put global hide_error_dialogs 1; do sleep 1; done"
    ],
    300
  ],
  [
    "boot",
    [
      "shell",
      "while [ \"$(getprop sys.boot_completed)\" != \"1\" ]; do sleep 1; done; getprop sys.boot_completed"
    ],
    300
  ],
  [
    "window_animation_scale",
    [
      "shell",
      "settings",
      "put",
      "global",
      "window_animation_scale",
      "0"
    ],
    90
  ],
  [
    "transition_animation_scale",
    [
      "shell",
      "settings",
      "put",
      "global",
      "transition_animation_scale",
      "0"
    ],
    90
  ],
  [
    "animator_duration_scale",
    [
      "shell",
      "settings",
      "put",
      "global",
      "animator_duration_scale",
      "0"
    ],
    90
  ],
  [
    "boot-logcat",
    [
      "logcat",
      "-d"
    ],
    90
  ],
  [
    "install",
    [
      "install",
      "-r",
      "/workspace/arrival-runtime-rc4/ArrivalBrief_release.apk"
    ],
    240
  ],
  [
    "device-sha",
    [
      "shell",
      "sha256sum $(pm path studio.ax.arrival | cut -d: -f2)"
    ],
    90
  ],
  [
    "clear-logcat",
    [
      "logcat",
      "-c"
    ],
    90
  ],
  [
    "release-scenario",
    null,
    480
  ],
  [
    "final-device-sha",
    [
      "shell",
      "sha256sum $(pm path studio.ax.arrival | cut -d: -f2)"
    ],
    90
  ]
]
